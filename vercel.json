{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ghost": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "functions": {
        "Dockerfile.vercel": {
          "maxConcurrency": 50
        }
      }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "ghost" } }]
}
