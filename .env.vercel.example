# Environment variables for the Vercel Ghost deployment.
# Set these in Project Settings -> Environment Variables (or `vercel env add`).
# Ghost maps `__` to config nesting (nconf separator, shared/config/loader.ts:37).

# --- Vercel routing -----------------------------------------------------------------
# Read by Vercel to decide which container port receives traffic. Without it Vercel
# sends to :80 and every request times out.
PORT=2368

# --- Ghost identity -----------------------------------------------------------------
NODE_ENV=production
# MUST equal the hostname clients actually use. Ghost 301-redirects any request whose
# Host header differs, which reads as a redirect loop. The image defaults this to
# http://localhost:2368, so it always needs overriding.
url=https://ghost-app.staging.opendefense.dev

# --- Database -------------------------------------------------------------------------
# Production uses RDS MySQL (perenv_storage_buckets), values from SSM /<env>.GHOST_DB_*:
#   database__client=mysql2            (exactly mysql2: connection.js:65 gates timezone/utf8mb4 on it)
#   database__connection__host / port / user / database / password
#   database__connection__ssl=Amazon RDS
# The last one is REQUIRED: the RDS parameter group sets require_secure_transport=ON, so a
# plaintext connection is refused. "Amazon RDS" is mysql2's built-in profile -- it bundles the
# RDS root CAs and verifies the server certificate; no PEM to ship.
#
# Connection pool -- these matter on Vercel specifically. Vercel runs the container as an
# autoscaling pool, not one long-lived process (28 instances were live at once during a
# scan), and every instance opens its own knex pool. knex's default min=2 means each idle
# instance parks 2 connections it never uses; that alone exhausted the RDS ceiling
# (Max_used_connections 140 vs max_connections 137, since raised to 300).
# min=0 lets an idle instance hold nothing; max=8 bounds the worst case.
# nconf parses these to numbers (parseValues:true in shared/config/loader.ts), and
# data/db/connection.js only overwrites dbConfig.pool on the better-sqlite3 branch, so for
# mysql2 they reach knex untouched.
database__pool__min=0
database__pool__max=8
#
# --- SQLite alternative (single container, no external DB) ----------------------------
# Ghost bundles better-sqlite3 and the official image ships it compiled
# (Dockerfile.production smoke-tests `require('better-sqlite3')` before shipping).
# `useNullAsDefault` and `PRAGMA foreign_keys = ON` are applied automatically in
# data/db/connection.js:29-50 — no extra knex config needed.
# No external MySQL, no RDS, no Marketplace add-on.
database__client=better-sqlite3
database__connection__filename=/var/lib/ghost/content/data/ghost.db

# If the container filesystem turns out to be read-only outside /tmp, switch to:
#   paths__contentPath=/tmp/ghost-content
#   database__connection__filename=/tmp/ghost-content/data/ghost.db
# Ghost creates the subdirectories on boot.

# --- Mail -----------------------------------------------------------------------------
# REQUIRED for member auth: Ghost members have no password, so a magic link IS the
# login mechanism. The image defaults mail.transport to "Direct", which attempts
# direct-to-MX delivery and hangs.
#
# NOTE: Ghost on Vercel has no ambient AWS identity, so the SES transport needs real
# credentials. Give them to Ghost DIRECTLY via mail.options -- Ghost's `ses`
# transport reads options.accessKeyId / options.secretAccessKey and passes them straight
# into SESv2Client.
#
# Do NOT rely on AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here. Vercel lists them as
# allowed, but its runtime populates those names itself ("may appear in your Vercel
# Functions even if you don't set them ... not usable as AWS credentials"). In the
# container runtime the SDK default chain ended up with nothing usable and every send
# failed with "Could not load credentials". Ghost's own keys sidestep that entirely.
#
# Use the `ghost-app-ses-<env>` IAM user that perenv_storage_buckets creates; its key lives in SSM as
# /<env>.GHOST_SES_ACCESS_KEY_ID and /<env>.GHOST_SES_SECRET_ACCESS_KEY.
mail__transport=ses
mail__options__region=us-west-2
mail__options__accessKeyId=
mail__options__secretAccessKey=
mail__from=Ghost DAST <noreply@ghost.staging.opendefense.dev>

# Constrains the member sender domain. Without these Ghost takes the self-hoster path
# (email-address-service.ts:134) and sends whatever the persisted members_support_address
# setting holds — which on a fresh database expands to noreply@<url host> and is rejected
# by SES. With them, getDefaultEmailDomain() returns the sending domain and any off-domain
# from-address is rewritten to the default with the original kept as Reply-To.
hostSettings__managedEmail__enabled=true
hostSettings__managedEmail__sendingDomain=ghost.staging.opendefense.dev
