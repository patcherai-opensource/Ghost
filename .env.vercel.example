# Environment variables for the Vercel Ghost deployment.
# Set these in Project Settings -> Environment Variables (or `vercel env add`).
# Ghost maps `__` to config nesting (nconf separator, shared/config/loader.ts:37).

# --- Vercel routing -----------------------------------------------------------------
# Read by Vercel to decide which container port receives traffic. Without it Vercel
# sends to :80 and every request times out.
PORT=2368

# --- Ghost identity -----------------------------------------------------------------
NODE_ENV=production
# MUST equal the hostname clients actually use. Ghost 301-redirects any request whose
# Host header differs, which reads as a redirect loop. The image defaults this to
# http://localhost:2368, so it always needs overriding.
url=https://YOUR-DEPLOYMENT.vercel.app

# --- Database: SQLite on the container filesystem ------------------------------------
# Ghost bundles better-sqlite3 and the official image ships it compiled
# (Dockerfile.production smoke-tests `require('better-sqlite3')` before shipping).
# `useNullAsDefault` and `PRAGMA foreign_keys = ON` are applied automatically in
# data/db/connection.js:29-50 — no extra knex config needed.
# No external MySQL, no RDS, no Marketplace add-on.
database__client=better-sqlite3
database__connection__filename=/var/lib/ghost/content/data/ghost.db

# If the container filesystem turns out to be read-only outside /tmp, switch to:
#   paths__contentPath=/tmp/ghost-content
#   database__connection__filename=/tmp/ghost-content/data/ghost.db
# Ghost creates the subdirectories on boot.

# --- Mail -----------------------------------------------------------------------------
# REQUIRED for member auth: Ghost members have no password, so a magic link IS the
# login mechanism. The image defaults mail.transport to "Direct", which attempts
# direct-to-MX delivery and hangs.
#
# NOTE: unlike the k8s deployment, there is no Pod Identity here, so the SES transport
# needs real credentials. Ghost's `ses` transport builds an SESv2Client and falls back to
# the AWS SDK default credential chain when mail__options__accessKeyId is unset — so the
# standard AWS_* vars below are picked up without putting keys in the mail config.
# The existing `ghost-app-staging` role will NOT work: its trust policy only admits
# pods.eks.amazonaws.com. Either mint an IAM user with the same SES policy, or add the
# Vercel OIDC provider to that role's trust statements.
mail__transport=ses
mail__options__region=us-west-2
mail__from=Ghost DAST <noreply@ghost.staging.depthfirst.com>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Constrains the member sender domain. Without these Ghost takes the self-hoster path
# (email-address-service.ts:134) and sends whatever the persisted members_support_address
# setting holds — which on a fresh database expands to noreply@<url host> and is rejected
# by SES. With them, getDefaultEmailDomain() returns the sending domain and any off-domain
# from-address is rewritten to the default with the original kept as Reply-To.
hostSettings__managedEmail__enabled=true
hostSettings__managedEmail__sendingDomain=ghost.staging.depthfirst.com
